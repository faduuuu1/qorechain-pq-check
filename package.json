{
  "name": "qorechain-pq-check",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A QoreChain EVM dApp: a Solidity Counter contract deployed and exercised with viem via @qorechain/evm.",
  "scripts": {
    "deploy": "tsx --env-file=.env scripts/deploy.ts",
    "typecheck": "tsc --noEmit",
    "window": "tsx --env-file=.env scripts/window.ts",
    "check": "tsx --env-file=.env scripts/check.ts"
  },
  "dependencies": {
    "@cosmjs/stargate": "^0.39.0",
    "@qorechain/evm": "^0.14.0",
    "@qorechain/sdk": "^0.14.0",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
