{
  "name": "qorechain-pq-check",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Post-quantum readiness checker for QoreChain accounts: reads the ML-DSA-87 key and EVM authorisation window over REST and says whether an EVM transaction would be admitted.",
  "scripts": {
    "deploy": "tsx --env-file=.env scripts/deploy.ts",
    "typecheck": "tsc --noEmit",
    "window": "tsx --env-file=.env scripts/window.ts",
    "check": "tsx --env-file=.env scripts/check.ts",
    "test": "tsx --test test/*.test.ts",
    "balance": "node balance.mjs",
    "verify": "node verify.mjs",
    "compile": "node scripts/compile.mjs",
    "deploy:gate": "tsx --env-file=.env scripts/deploy-gate.ts",
    "swap": "tsx --env-file=.env scripts/swap.ts",
    "kem": "tsx --env-file=.env scripts/kem.ts"
  },
  "dependencies": {
    "@cosmjs/stargate": "^0.39.0",
    "@qorechain/evm": "^0.14.0",
    "@qorechain/pqc": "^0.2.3",
    "@qorechain/sdk": "^0.14.0",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "create-qorechain-dapp": "^0.14.0",
    "solc": "^0.8.24",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faduuuu1/qorechain-pq-check.git"
  }
}
